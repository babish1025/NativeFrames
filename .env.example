# XAMPP / local development
NATIVEFRAMES_DB_HOST=localhost
NATIVEFRAMES_DB_PORT=3307
NATIVEFRAMES_DB_USER=root
NATIVEFRAMES_DB_PASSWORD=
NATIVEFRAMES_DB_NAME=nativeframes
NATIVEFRAMES_DB_AUTO_CREATE=true

# Optional: replace the individual DB settings with a cloud MySQL URL.
# NATIVEFRAMES_DATABASE_URL=mysql://USERNAME:PASSWORD@HOST:3306/nativeframes

NATIVEFRAMES_ADMIN_USERNAME=nativeframes
NATIVEFRAMES_ADMIN_PASSWORD=nativeframes@24

# Optional cloud persistent-disk upload location.
# NATIVEFRAMES_UPLOAD_DIR=/var/data/nativeframes/uploads
